{
  "name": "editast-demo",
  "version": "1.0.0",
  "description": "The README demo GIF: a video next to its editast HTML report, rendered with Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/media": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "gifsicle": "7.0.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "frames": "remotion render Dune out/frames --sequence --image-format=png --scale=0.6875",
    "frames:car": "remotion render CarEdit out/car-frames --sequence --image-format=png --scale=0.6875",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false,
    "gifsicle": true
  }
}
